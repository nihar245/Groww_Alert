# ─────────────────────────────────────────────────────────────────────────────
# Groww Alert — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# WhatsApp number that will RECEIVE the alert, in E.164 format.
# Example: +919876543210
WHATSAPP_PHONE=+91XXXXXXXXXX

# ── Meta WhatsApp Business Cloud API ─────────────────────────────────────────
# Get these from: https://developers.facebook.com
#   → Your App → WhatsApp → API Setup
#
# 1. "Phone Number ID" field  (numeric string, e.g. 123456789012345)
WA_PHONE_NUMBER_ID=XXXXXXXXXXXXXXX
#
# 2. "Temporary access token" (or a permanent System User token)
WA_ACCESS_TOKEN=EAAG...your_token_here
